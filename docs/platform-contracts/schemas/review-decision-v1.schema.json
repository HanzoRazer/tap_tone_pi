{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-decision-v1.schema.json",
  "title": "ReviewDecisionV1",
  "description": "Cross-repository contract for review decision semantics. See review-decision-v1.md for prose definition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_type",
    "human_review_recorded",
    "implementation_authorized",
    "execution_authorized",
    "machine_output_allowed"
  ],
  "properties": {
    "decision_type": {
      "type": "string",
      "enum": [
        "acknowledge",
        "request_more_evidence",
        "defer",
        "reject",
        "mark_reviewed",
        "approve_for_downstream_review"
      ],
      "description": "The reviewer action taken"
    },
    "resulting_status": {
      "type": "string",
      "enum": [
        "pending",
        "under_review",
        "needs_evidence",
        "deferred",
        "rejected",
        "reviewed",
        "approved_downstream"
      ],
      "description": "The pipeline status after this decision"
    },
    "human_review_recorded": {
      "const": true,
      "description": "Always true - a decision records human review"
    },
    "implementation_authorized": {
      "const": false,
      "description": "Always false - review does not authorize implementation"
    },
    "execution_authorized": {
      "const": false,
      "description": "Always false - review does not authorize execution"
    },
    "machine_output_allowed": {
      "const": false,
      "description": "Always false - review does not allow machine output"
    },
    "reviewer_ref": {
      "type": "string",
      "description": "Reviewer identifier"
    },
    "source_repo": {
      "type": "string",
      "description": "Repository that recorded this decision"
    },
    "local_decision_type": {
      "type": "string",
      "description": "Repository-local decision type for mapping"
    }
  }
}
