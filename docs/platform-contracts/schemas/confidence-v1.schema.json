{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "confidence-v1.schema.json",
  "title": "ConfidenceV1",
  "description": "Cross-repository contract for typed confidence values. See confidence-v1.md for prose definition.",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain", "value", "source"],
  "properties": {
    "domain": {
      "type": "string",
      "enum": [
        "signal",
        "measurement",
        "interpretive",
        "recommendation",
        "historical",
        "ranking"
      ],
      "description": "The confidence domain (determines authority ceiling)"
    },
    "value": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence value in [0.0, 1.0]"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "Algorithm or process that produced this confidence value"
    },
    "does_not_imply": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "correctness",
          "approval",
          "execution_authority",
          "review_bypass",
          "measurement_truth"
        ]
      },
      "uniqueItems": true,
      "description": "Explicit list of things this confidence does not imply"
    }
  }
}
