{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epistemic-status-v1.schema.json",
  "title": "EpistemicStatusV1",
  "description": "Cross-repository contract for epistemic status classification. See epistemic-status-v1.md for prose definition.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "source", "may_enter_measurement_export"],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "observed",
        "derived",
        "estimated",
        "predicted",
        "heuristic",
        "operator_annotated",
        "externally_sourced"
      ],
      "description": "The epistemic status of the artifact"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "Algorithm, operator, or system that produced this artifact"
    },
    "may_enter_measurement_export": {
      "type": "boolean",
      "description": "Whether this artifact may enter measurement export packages"
    },
    "authority_notes": {
      "type": "string",
      "description": "Additional context about authority classification"
    },
    "prohibited_transitions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "observed",
          "derived",
          "estimated",
          "predicted",
          "heuristic",
          "operator_annotated",
          "externally_sourced"
        ]
      },
      "uniqueItems": true,
      "description": "Statuses this artifact may not transition to"
    }
  },
  "$defs": {
    "ObservedArtifact": {
      "type": "object",
      "description": "Direct sensor capture",
      "properties": {
        "status": { "const": "observed" },
        "source": { "type": "string", "minLength": 1 },
        "may_enter_measurement_export": { "const": true }
      },
      "required": ["status", "source", "may_enter_measurement_export"]
    },
    "DerivedArtifact": {
      "type": "object",
      "description": "Computed from observed data",
      "properties": {
        "status": { "const": "derived" },
        "source": { "type": "string", "minLength": 1 },
        "may_enter_measurement_export": { "const": true },
        "prohibited_transitions": {
          "type": "array",
          "items": { "const": "observed" }
        }
      },
      "required": ["status", "source", "may_enter_measurement_export"]
    },
    "PredictedArtifact": {
      "type": "object",
      "description": "Model output - cannot become measurement",
      "properties": {
        "status": { "const": "predicted" },
        "source": { "type": "string", "minLength": 1 },
        "may_enter_measurement_export": { "const": false },
        "prohibited_transitions": {
          "type": "array",
          "items": { "enum": ["observed", "derived", "estimated"] }
        }
      },
      "required": ["status", "source", "may_enter_measurement_export"]
    },
    "HeuristicArtifact": {
      "type": "object",
      "description": "Rule-based suggestion - cannot become measurement",
      "properties": {
        "status": { "const": "heuristic" },
        "source": { "type": "string", "minLength": 1 },
        "may_enter_measurement_export": { "const": false },
        "prohibited_transitions": {
          "type": "array",
          "items": { "enum": ["observed", "derived", "estimated"] }
        }
      },
      "required": ["status", "source", "may_enter_measurement_export"]
    }
  }
}
