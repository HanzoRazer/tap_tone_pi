+    margin: float = 1.0,
+) -> dict[str, float]:
+    """
+    Total and external jitter allowance for an SNR target, with the converter's
+    own noise power removed first.
+
+        feasibility:  SNR_converter > SNR_target,  else no clock reaches it
+        r_j       = 10^(-SNR_target/10) - 10^(-SNR_converter/10)
+        t_j,max   = sqrt(r_j) / (2 pi f_in)
+        t_ext,max = sqrt(t_j,max^2 - t_ap^2)
+
+    Supersedes jitter_budget_s() for allocation. That form assumes ALL noise is
+    jitter noise, which inflates the allowance -- negligibly far from the
+    converter's capability, severely near it (2.2x at 1 dB away, and a finite
+    answer where the honest answer is "impossible").
+
+    `margin` scales the external allowance for design headroom; 0.7 is common
+    when component figures are typical rather than guaranteed.
+    """
+    if converter_snr_db <= target_snr_db:
+        raise InfeasibleTarget(
+            f"converter SNR {converter_snr_db:.2f} dB does not exceed target "
+            f"{target_snr_db:.2f} dB; no clock improvement reaches it"
+        )
+    r_j = 10.0 ** (-target_snr_db / 10.0) - 10.0 ** (-converter_snr_db / 10.0)
