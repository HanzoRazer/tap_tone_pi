+def threshold_noise_jitter_s(v_noise_rms: float, slew_v_per_s: float) -> float:
+    """
+    Timing jitter induced by voltage noise at a clock receiver's threshold:
+
+        t_j = v_n,rms / (dV/dt)|threshold
+
+    Noise becomes timing error only while the edge crosses the threshold, so a
+    steeper edge shortens the exposure. The relevant slew is at the ADC clock
+    pin, not the oscillator's datasheet rise time. For a sine clock,
+    S_zero-crossing = 2*pi*f_s*V_p.
+
+    Does NOT reduce intrinsic aperture jitter -- this is a delivered-clock term.
+    """
+    if slew_v_per_s <= 0:
+        raise ValueError("slew rate must be positive")
+    return v_noise_rms / slew_v_per_s
