+def phase_noise_to_jitter(
+    points_dbc_per_hz: list[tuple[float, float]],
+    f_low_hz: float,
+    f_high_hz: float,
+    carrier_hz: float,
+) -> dict[str, float]:
+    """
+    RMS jitter from tabulated SSB phase noise L(f).
+
+        phi^2 = 2 * integral[f_L -> f_H] 10^(L(f)/10) df
+        t_j   = phi / (2 pi f_carrier)
+
+    points are (offset_hz, L_dbc_per_hz), integrated piecewise in LINEAR units.
+    dBc/Hz values are never averaged or summed directly.
+
+    f_low, f_high and carrier are MANDATORY, not defaults. A jitter figure
+    without its integration limits and carrier is not a quantity and cannot
+    enter a budget -- the standing objection to any vendor claim of a
+    "low-jitter clock" carrying no numbers. Integration commonly runs to at
+    least f_s, sometimes 2*f_s, when nothing filters between oscillator and ADC.
+
+    The integration band must match the SNR integration band it will be
+    subtracted from.
+    """
+    pts = sorted((f, L) for f, L in points_dbc_per_hz if f_low_hz <= f <= f_high_hz)
+    if len(pts) < 2:
+        raise ValueError("need at least 2 phase-noise points inside the band")
+    area = 0.0
+    for (f0, l0), (f1, l1) in zip(pts, pts[1:]):
+        p0 = 10.0 ** (l0 / 10.0)
+        p1 = 10.0 ** (l1 / 10.0)
+        area += 0.5 * (p0 + p1) * (f1 - f0)  # linear-units trapezoid
+    phi_rms = math.sqrt(2.0 * area)
+    return {
+        "phi_rms_rad": phi_rms,
+        "t_j_s": phi_rms / (2.0 * math.pi * carrier_hz),
+        "f_low_hz": f_low_hz,
+        "f_high_hz": f_high_hz,
+        "carrier_hz": carrier_hz,
+    }
+
