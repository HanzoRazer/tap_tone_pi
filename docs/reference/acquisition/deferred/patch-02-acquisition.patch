+def fit_jitter_from_sweep(
+    f_in_hz: list[float], snr_db: list[float]
+) -> dict[str, float]:
+    """
+    Total jitter from a multi-frequency SNR sweep, by least squares on
+
+        r(f) = r0 + (2 pi t_j)^2 f^2       with r = 10^(-SNR/10)
+
+    Slope gives t_j = sqrt(slope) / (2 pi); intercept r0 is the frequency-
+    independent baseline. Strictly better than the two-point AN-501 subtraction:
+    the residual reports whether the loss actually has a jitter signature rather
+    than an analog-bandwidth or source-noise signature.
+
+    Critically for an audio-band instrument, the resulting BOUND is set by SNR
+    repeatability rather than by absolute SNR. At 0.1 dB repeatability this
+    bounds total jitter near 36 ps -- against ~25 ns from a single-point bound.
+    Three orders of magnitude, converting the BOUNDED aperture tag from an
+    assertion into a measured negative result.
+
+    A poor r_squared means the jitter interpretation is not supported: check
+    analog bandwidth, source phase noise, amplitude drift, and non-coherent
+    leakage before believing t_j.
+    """
+    if len(f_in_hz) != len(snr_db) or len(f_in_hz) < 3:
+        raise ValueError("need at least 3 matched (f_in, SNR) pairs")
+    xs = [f * f for f in f_in_hz]
+    ys = [10.0 ** (-s / 10.0) for s in snr_db]
+    n = len(xs)
+    mx = sum(xs) / n
+    my = sum(ys) / n
+    sxx = sum((x - mx) ** 2 for x in xs)
+    if sxx == 0:
+        raise ValueError("all input frequencies identical; cannot fit")
+    sxy = sum((x - mx) * (y - my) for x, y in zip(xs, ys))
+    slope = sxy / sxx
+    intercept = my - slope * mx
+    ss_tot = sum((y - my) ** 2 for y in ys)
+    ss_res = sum((y - (intercept + slope * x)) ** 2 for x, y in zip(xs, ys))
+    r2 = 1.0 - (ss_res / ss_tot) if ss_tot > 0 else float("nan")
+    t_j = math.sqrt(slope) / (2.0 * math.pi) if slope > 0 else 0.0
+    return {
+        "slope": slope,
+        "intercept_r0": intercept,
+        "baseline_snr_db": (
+            -10.0 * math.log10(intercept) if intercept > 0 else float("nan")
+        ),
+        "t_j_total_s": t_j,
+        "r_squared": r2,
+        "slope_positive": slope > 0,
+    }
+
