{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/phase1_tap_analysis_v1.schema.json",
  "title": "Phase1TapAnalysis",
  "description": "Output schema for Phase 1 single-channel tap tone analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "timestamp_utc", "sample_rate", "analysis", "quality"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "phase1_tap_analysis_v1"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when analysis was performed"
    },
    "sample_rate": {
      "type": "integer",
      "minimum": 8000,
      "description": "Sample rate in Hz"
    },
    "duration_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Recording duration in seconds"
    },
    "label": {
      "type": "string",
      "description": "Optional point label or identifier"
    },
    "demo": {
      "type": "boolean",
      "description": "True if generated from synthetic audio"
    },
    "seed": {
      "type": ["integer", "null"],
      "description": "Random seed if demo mode"
    },
    "fundamental_hz_expected": {
      "type": "number",
      "description": "Expected fundamental frequency if demo mode"
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dominant_hz", "peaks", "clipped", "rms", "confidence"],
      "properties": {
        "dominant_hz": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Dominant frequency in Hz, null if no peaks detected"
        },
        "peaks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["freq_hz", "magnitude"],
            "properties": {
              "freq_hz": {
                "type": "number",
                "minimum": 0,
                "description": "Peak frequency in Hz"
              },
              "magnitude": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Normalized magnitude (0-1)"
              }
            }
          },
          "description": "Detected frequency peaks, sorted by magnitude descending"
        },
        "clipped": {
          "type": "boolean",
          "description": "True if audio signal was clipping"
        },
        "rms": {
          "type": "number",
          "minimum": 0,
          "description": "RMS signal level"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Physics-based confidence score (0-1)"
        },
        "confidence_components": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "snr_db": {
              "type": "number",
              "description": "Signal-to-noise ratio in dB"
            },
            "snr_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "flatness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Spectral flatness (0=tonal, 1=noise)"
            },
            "flatness_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "q_factor": {
              "type": ["number", "null"],
              "description": "Estimated Q from half-power bandwidth"
            },
            "q_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "description": "Breakdown of confidence score components"
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "policy_version"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["pass", "warn", "fail"],
          "description": "Quality gate verdict"
        },
        "policy_version": {
          "type": "string",
          "description": "Quality policy version used"
        },
        "triggered_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule_id", "severity", "message"],
            "properties": {
              "rule_id": {
                "type": "string",
                "pattern": "^Q[0-9]{3}$"
              },
              "severity": {
                "type": "string",
                "enum": ["hard", "soft"]
              },
              "description": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "description": "Quality rules that were triggered"
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audio": {
          "type": "string",
          "description": "Path to audio.wav file"
        },
        "analysis": {
          "type": "string",
          "description": "Path to analysis.json file"
        },
        "spectrum": {
          "type": "string",
          "description": "Path to spectrum.csv file"
        }
      },
      "description": "Paths to generated artifact files"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audio_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 hash of input audio"
        },
        "environment": {
          "type": "object",
          "properties": {
            "temp_c": {
              "type": "number",
              "description": "Temperature in Celsius"
            },
            "rh_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Relative humidity percentage"
            }
          }
        }
      },
      "description": "Provenance tracking fields"
    }
  }
}
