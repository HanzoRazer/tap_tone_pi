{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/phase2_ods_snapshot.schema.json",
  "title": "Phase2ODSSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capdir", "freqs_hz", "points"],
  "properties": {
    "schema_version": { "type": "string", "const": "phase2_ods_snapshot_v1" },
    "capdir": { "type": "string" },

    "freqs_hz": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "number", "exclusiveMinimum": 0 }
    },

    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["point_id", "x_mm", "y_mm", "H_mag", "H_phase_deg"],
        "properties": {
          "point_id": { "type": "string", "pattern": "^[A-Z][0-9]{1,2}$" },
          "x_mm": { "type": "number" },
          "y_mm": { "type": "number" },

          "H_mag": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "number", "minimum": 0 }
          },
          "H_phase_deg": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "number" }
          },

          "coherence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    }
  }
}
