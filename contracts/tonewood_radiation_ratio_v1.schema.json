{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/tonewood_radiation_ratio_v1.schema.json",
  "title": "TonewoodRadiationRatioContract",
  "description": "Cross-repository interoperability contract for the Schelleng tonewood radiation ratio (BR-045). Defines formula identity, units, unscaled SI-derived output convention, validity rules, and numerical conformance fixtures. Does not rank materials or assert threshold science.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "formula_id",
    "formula_version",
    "name",
    "canonical_expression",
    "equivalent_expressions",
    "input_quantities",
    "output_quantity",
    "scale_factor",
    "output_convention",
    "rounding_decimals",
    "validity_requirements",
    "error_behavior",
    "conformance_fixtures",
    "semantic_digest_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "tonewood_radiation_ratio_contract_v1"
    },
    "formula_id": {
      "type": "string",
      "const": "tonewood_radiation_ratio"
    },
    "formula_version": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "canonical_expression": {
      "type": "string",
      "const": "wave_speed_m_s / density_kg_m3"
    },
    "equivalent_expressions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "input_quantities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/InputQuantity" }
    },
    "output_quantity": {
      "$ref": "#/$defs/OutputQuantity"
    },
    "scale_factor": {
      "type": "number",
      "const": 1.0
    },
    "output_convention": {
      "type": "string",
      "const": "unscaled_si_derived"
    },
    "rounding_decimals": {
      "type": "integer",
      "const": 2
    },
    "validity_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "error_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zero_or_negative_density",
        "zero_or_negative_modulus",
        "zero_or_negative_wave_speed",
        "non_finite_input",
        "ambiguous_modulus_unit",
        "unknown_schema_version"
      ],
      "properties": {
        "zero_or_negative_density": { "type": "string", "const": "reject" },
        "zero_or_negative_modulus": { "type": "string", "const": "reject" },
        "zero_or_negative_wave_speed": { "type": "string", "const": "reject" },
        "non_finite_input": { "type": "string", "const": "reject" },
        "ambiguous_modulus_unit": { "type": "string", "const": "reject" },
        "unknown_schema_version": { "type": "string", "const": "reject" }
      }
    },
    "conformance_fixtures": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/ConformanceFixture" }
    },
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "absolute": { "type": "number", "minimum": 0 },
        "relative": { "type": "number", "minimum": 0 },
        "display_rounding_decimals": { "type": "integer", "minimum": 0 }
      }
    },
    "semantic_digest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of the normalized semantic contract (provenance fields excluded)."
    },
    "authority_repository": {
      "type": "string",
      "description": "Repository-local provenance; excluded from semantic digest."
    },
    "authority_contract_path": {
      "type": "string",
      "description": "Repository-local provenance; excluded from semantic digest."
    },
    "authority_commit": {
      "type": "string",
      "description": "Repository-local provenance; excluded from semantic digest."
    },
    "synchronized_at": {
      "type": "string",
      "description": "Repository-local provenance; excluded from semantic digest."
    }
  },
  "$defs": {
    "InputQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantity_id", "symbol", "name", "unit", "unit_system"],
      "properties": {
        "quantity_id": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "unit_system": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "OutputQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantity_id", "symbol", "name", "unit", "unit_system"],
      "properties": {
        "quantity_id": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "unit_system": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "ConformanceFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "label",
        "density_kg_m3",
        "dynamic_modulus_pa",
        "expected_radiation_ratio",
        "expected_radiation_ratio_rounded"
      ],
      "properties": {
        "fixture_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "specimen_class": { "type": "string" },
        "density_kg_m3": { "type": "number", "exclusiveMinimum": 0 },
        "dynamic_modulus_pa": { "type": "number", "exclusiveMinimum": 0 },
        "dynamic_modulus_gpa": { "type": "number", "exclusiveMinimum": 0 },
        "wave_speed_m_s": { "type": "number", "exclusiveMinimum": 0 },
        "expected_radiation_ratio": { "type": "number", "exclusiveMinimum": 0 },
        "expected_radiation_ratio_rounded": { "type": "number", "exclusiveMinimum": 0 },
        "notes": { "type": "string" }
      }
    }
  }
}
