{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tap-tone-pi.local/contracts/schemas/displacement_series.schema.json",
  "title": "Displacement Time Series",
  "description": "Dial indicator or LVDT displacement readings over time.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_id",
    "schema_version",
    "artifact_type",
    "created_utc",
    "unit",
    "sample_rate_hz",
    "data"
  ],

  "properties": {
    "schema_id": { "const": "displacement_series" },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Schema version (e.g. '1.0')"
    },

    "artifact_type": { "const": "displacement_series" },
    "created_utc": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when series was captured"
    },

    "unit": {
      "type": "string",
      "enum": ["mm", "in"],
      "description": "Displacement unit"
    },
    "sample_rate_hz": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Sampling rate in Hz (samples per second)"
    },

    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional sensor metadata",
      "properties": {
        "type": { "type": "string", "enum": ["dial_indicator", "lvdt", "laser", "other"] },
        "resolution_mm": { "type": "number", "exclusiveMinimum": 0 },
        "range_mm": { "type": "number", "exclusiveMinimum": 0 },
        "serial_number": { "type": "string" }
      }
    },

    "data": {
      "type": "array",
      "description": "Array of [time_s, displacement] pairs",
      "items": {
        "type": "array",
        "prefixItems": [
          { "type": "number", "description": "Time in seconds from start" },
          { "type": "number", "description": "Displacement in specified unit" }
        ],
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 1
    },

    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional computed statistics",
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "mean": { "type": "number" },
        "std": { "type": "number", "minimum": 0 },
        "n_samples": { "type": "integer", "minimum": 1 }
      }
    },

    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA256 hash of raw data file (if applicable)"
    }
  }
}
