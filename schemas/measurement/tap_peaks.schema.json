{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tap Tone Measurement",
  "description": "FFT peak summary from a single-mic tap-tone capture.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artifact_type": { "const": "tap_tone" },
    "sample_rate": { "type": "number", "exclusiveMinimum": 0 },
    "duration_s": { "type": "number", "exclusiveMinimum": 0 },
    "peaks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "freq_hz": { "type": "number", "exclusiveMinimum": 0 },
          "amp": { "type": "number" }
        },
        "required": ["freq_hz", "amp"]
      }
    }
  },
  "required": ["artifact_type", "sample_rate", "duration_s", "peaks"]
}
