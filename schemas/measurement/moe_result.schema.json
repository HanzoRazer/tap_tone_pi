{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MOE Result",
  "description": "Static bending modulus-of-elasticity summary from a bending-rig run.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artifact_type": { "const": "bending_test" },
    "E_GPa": { "type": "number", "exclusiveMinimum": 0 },
    "specific_modulus_GPa_per_gcm3": { "type": "number", "exclusiveMinimum": 0 },
    "c_m_s": { "type": "number", "exclusiveMinimum": 0 },
    "radiation_ratio": { "type": "number" }
  },
  "required": [
    "artifact_type",
    "E_GPa",
    "specific_modulus_GPa_per_gcm3",
    "c_m_s",
    "radiation_ratio"
  ]
}
